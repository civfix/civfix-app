# pnpm reads every setting from pnpm-workspace.yaml, where nodeLinker wins over this line. The repeat is a guard: every
# EAS build was proven with node-linker=hoisted here, and it keeps Metro's flat layout if the yaml setting is dropped.
node-linker=hoisted
# @civfix/contract is consumed from the private registry (anonymous read; auth only to publish).
@civfix:registry=https://repo.civfix.org/
