    "@react-native-community/datetimepicker": "8.4.4",
    "@shopify/react-native-skia": "2.2.12",
    "@tanstack/eslint-plugin-query": "5.103.2",
    "@tanstack/react-query": "^5.62.7",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@types/supercluster": "^7.1.3",
    "eslint": "^9.16.0",
