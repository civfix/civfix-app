      "default": "./src/surface/index.ts"
    },
    "./surface/liquidGlass": {
      "types": "./dist-types/surface/liquidGlass/index.d.ts",
      "react-native": "./src/surface/liquidGlass/index.ts",
      "default": "./src/surface/liquidGlass/index.ts"
    },
    "./capabilities": {
      "types": "./dist-types/capabilities/index.d.ts",
      "react-native": "./src/capabilities/index.ts",
      "default": "./src/capabilities/index.ts"
    },
    "./data": {
      "types": "./dist-types/data/index.d.ts",
      "react-native": "./src/data/index.ts",
      "default": "./src/data/index.ts"
    },
    "./realtime": {
      "types": "./dist-types/realtime/index.d.ts",
      "react-native": "./src/realtime/index.ts",
      "default": "./src/realtime/index.ts"
    },
    "./nav": {
      "types": "./dist-types/nav/index.d.ts",
      "react-native": "./src/nav/index.ts",
      "default": "./src/nav/index.ts"
    },
    "./bodies": {
      "types": "./dist-types/bodies/index.d.ts",
      "react-native": "./src/bodies/index.ts",
      "default": "./src/bodies/index.ts"
    },
    "./social": {
      "types": "./dist-types/primitives/socialLinksModel.d.ts",
      "react-native": "./src/primitives/socialLinksModel.ts",
      "default": "./src/primitives/socialLinksModel.ts"
    },
    "./i18n": {
      "types": "./dist-types/i18n/index.d.ts",
      "react-native": "./src/i18n/index.ts",
      "default": "./src/i18n/index.ts"
    },
    "./package.json": "./package.json",
    "./helpers": {
      "types": "./dist-types/helpers/index.d.ts",
      "react-native": "./src/helpers/index.ts",
      "default": "./src/helpers/index.ts"
    },
    "./helpers/*": {
      "types": "./dist-types/helpers/*.d.ts",
      "react-native": "./src/helpers/*.ts",
      "default": "./src/helpers/*.ts"
    }
  },
  "files": [
    "src",
    "dist-types"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist-types",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.vitest.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 eslint . --max-warnings=0",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "i18n:check:resources": "node scripts/check-i18n-resources.mjs",
    "i18n:gen": "node scripts/gen-i18n-resources.mjs",
    "clean": "rimraf dist-types *.tsbuildinfo"
  },
  "peerDependencies": {
    "@gorhom/bottom-sheet": "*",
