  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "source": "./src/index.ts",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "react-native": "./src/index.ts",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme": {
      "types": "./dist-types/theme/index.d.ts",
      "react-native": "./src/theme/index.ts",
      "default": "./src/theme/index.ts"
    },
    "./theme/schemes": {
