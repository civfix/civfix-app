  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme": {
      "types": "./dist-types/theme/index.d.ts",
      "react-native": "./src/theme/index.ts",
      "default": "./src/theme/index.ts"
    },
    "./theme/schemes": {
      "types": "./dist-types/theme/schemes.d.ts",
      "react-native": "./src/theme/schemes.ts",
      "default": "./src/theme/schemes.ts"
    },
    "./typography": {
      "types": "./dist-types/typography/index.d.ts",
      "react-native": "./src/typography/index.ts",
      "default": "./src/typography/index.ts"
    },
    "./surface": {
      "types": "./dist-types/surface/index.d.ts",
