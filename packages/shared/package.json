  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rimraf dist *.tsbuildinfo",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "zod": "^3.23"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://repo.civfix.org",
    "access": "public"
  }
}
