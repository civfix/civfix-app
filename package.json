{
  "name": "civfix-app",
  "version": "0.0.0",
  "private": true,
  "description": "civfix consumer plane: the @civfix/tokens design tokens, the @civfix/ui component set, the community web app and the community mobile app.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": "^24.15",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint lint:scripts",
    "lint:scripts": "eslint scripts --max-warnings=0",
    "typecheck": "turbo run typecheck typecheck:scripts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "i18n:check": "turbo run i18n:check && pnpm i18n:check:call-sites",
    "i18n:check:call-sites": "node scripts/check-i18n-call-sites.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "knip": "knip",
    "jscpd": "jscpd",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "doctor:expo": "pnpm --filter community-mobile run doctor:expo",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.2",
    "@typescript/native": "npm:typescript@^7",
    "eslint": "^9.16.0",
    "jscpd": "4.3.0",
    "knip": "6.44.1",
    "prettier": "3.9.9",
    "turbo": "^2.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.18.0"
  }
}
