{
  "name": "civfix-app",
  "version": "0.0.0",
  "private": true,
  "description": "civfix consumer plane: the @civfix/tokens design tokens, the @civfix/ui component set, the community web app and the community mobile app.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "engines": {
    "node": "^22.22.2 || >=24.15",
    "pnpm": ">=10.34 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint lint:scripts",
    "lint:scripts": "eslint scripts --max-warnings=0",
    "typecheck": "turbo run typecheck typecheck:scripts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "i18n:check": "turbo run i18n:check && pnpm i18n:check:call-sites",
    "i18n:check:call-sites": "node scripts/check-i18n-call-sites.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "knip": "knip",
    "jscpd": "jscpd",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "doctor:expo": "pnpm --filter community-mobile run doctor:expo",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.16.0",
    "jscpd": "4.3.0",
    "knip": "5.88.1",
    "prettier": "3.9.9",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  }
}
