{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"]
    },
    "packages/shared": {
      "entry": ["src/**/*.test.ts", "__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "__tests__/**/*.ts"]
    },
    "packages/ui": {
      "entry": [
        "src/**/*.web.{ts,tsx}",
        "src/**/*.native.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "scripts/*.mjs"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/*.mjs"],
      // @civfix/ui is private: its only consumers are the two apps in this repo, so an export of a
      // package `exports` subpath that neither app imports is dead surface, not public API.
      "includeEntryExports": true
    },
    "apps/community-web": {
      "entry": [
        // Dev-only gallery routes: next.config.mjs adds the `dev.tsx` page extension under `next dev`.
        "src/app/**/{page,layout}.dev.tsx",
        "functions/**/*.ts",
        "scripts/*.mjs"
      ],
      "project": ["src/**/*.{ts,tsx}", "functions/**/*.ts", "scripts/*.mjs"],
      "ignoreDependencies": [
        // scripts/copy-contract-fonts.mjs copies the font files by path; nothing imports the packages.
        "@fontsource/.+",
        // eslint.config.mjs resolves the react/jsx-a11y/import plugins through this preset's own
        // require, which static analysis cannot follow.
        "eslint-config-next",
        // A JSDoc type import in postcss.config.mjs; the package ships with postcss.
        "postcss-load-config"
      ]
    },
    "apps/community-mobile": {
      "entry": [
        "scripts/*.mjs",
        "tests/**/*.test.ts",
        "src/**/*.test.ts"
      ],
      "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "tests/**/*.ts", "scripts/*.mjs"],
      "ignoreDependencies": [
        // Removed by campaign PR 1 (a separate main-based PR); removing them here would conflict with it.
        "expo-contacts",
        "expo-sms",
        // The one-off asset generators in scripts/ ask for these to be installed with --no-save; they
        // are never runtime or CI dependencies.
        "sharp",
        "opentype.js"
      ],
      // Shell scripts run by package.json scripts, not package binaries.
      "ignoreBinaries": ["scripts/store-build.sh", "scripts/prep-archive.sh"]
    }
  },
  // expo-doctor runs through npx on purpose (CI and the root `doctor` script): it is not a dependency.
  "ignoreBinaries": ["expo-doctor"],
  // A type used in its own file often names the shape of an exported value (props, a hook's return);
  // un-exporting it breaks the ui declaration build (TS4023/TS4058), so only foreign-unused types count.
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "ignoreIssues": {
    // Metro (native) and the web bundler (.web first) pick a platform twin by file extension, which
    // knip cannot model: the twin's exports are consumed through the extension-less selector.
    "packages/ui/src/**/*.{native,web}.{ts,tsx}": ["exports", "types"],
    // Published contract: the DTO schema and its endpoint response alias are both public names that
    // registry consumers import.
    "packages/shared/src/**": ["duplicates"],
    // Deliberate aliases that name one value for two call sites (step-1 and step-3 gate; back and
    // trailing header button); tests pin the relation.
    "packages/ui/src/bodies/channelWizard.ts": ["duplicates"],
    "packages/ui/src/shell/detailHeader.ts": ["duplicates"]
  }
}
