# Cloudflare Pages response headers for the civfix community web static export.
#
# Lives in public/ and is copied verbatim into the export output (out/_headers); Cloudflare
# consumes it at deploy time and it is NOT served as a static asset.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# IMPORTANT: these headers ONLY take effect on Cloudflare Pages. `next dev` and a local static
# file server (e.g. `python -m http.server --directory out`) ignore this file, so local
# development and local export previews are unaffected.
#
# MERGE SEMANTICS: a request that matches several rules inherits ALL of their headers, and a
# header set by two matching rules is comma-JOINED (not overridden). Because `/*` matches
# everything (including /_next/static/*), we must not set Cache-Control on both `/*` and
# `/_next/static/*` or the asset cache header becomes a corrupt, joined value. The `/_next/static/*`
# block therefore drops the inherited Cache-Control with `! Cache-Control` before setting its own.

# --- Pervasive defaults: applied to every response. ---
# Short, revalidated caching for the HTML shells so a new deploy is picked up promptly (ETag/304
# keeps revalidation cheap). Security headers ride on every response.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: accelerometer=(), autoplay=(self), camera=(), fullscreen=(self), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com

# --- Content-hashed build assets: cache immutably for a year. ---
# Files under /_next/static carry a content hash in their name, so a given URL never changes.
# Drop the inherited short-cache from `/*` first (see MERGE SEMANTICS above), then cache hard.
/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# --- Broadcast unsubscribe: never indexed (the URL carries a one-click token). ---
/unsubscribe*
  X-Robots-Tag: noindex

# --- Apple universal-link association file. ---
# iOS fetches /.well-known/apple-app-site-association (no extension) and REQUIRES an
# application/json content type; Cloudflare would otherwise guess from the missing extension. Only
# Content-Type is set here, and no other matching rule sets it, so the comma-join described in MERGE
# SEMANTICS above cannot corrupt it (the inherited Cache-Control from `/*` is deliberately kept:
# short, revalidated caching is what we want for this file).
/.well-known/apple-app-site-association
  Content-Type: application/json

# --- Share-card artwork: pin the image content type. ---
# iMessage/WhatsApp only render a link card when the og:image answers with an image content type on
# the FIRST response (no redirect, no sniffing), so state it explicitly rather than trusting the
# extension guess. Only Content-Type is set here, so the comma-join described in MERGE SEMANTICS
# cannot corrupt it (the short, revalidated Cache-Control inherited from `/*` is deliberately kept).
/og.png
  Content-Type: image/png

/apple-touch-icon.png
  Content-Type: image/png

/manifest.webmanifest
  Content-Type: application/manifest+json

# --- Internal SPA browse-fallback copies: keep them out of search indexes. ---
# scripts/cf-pages-postbuild.mjs copies each browse page to /__spa/<route>/ so the _redirects
# protective rules have a non-looping target. They duplicate the canonical /<route>/ page, so tell
# crawlers not to index them (nothing links here; this is belt-and-suspenders against duplicates).
/__spa/*
  X-Robots-Tag: noindex
