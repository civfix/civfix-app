{
  "name": "community-web",
  "version": "1.4.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "civfix public user web app: static-exported Next.js SPA over the civfix API.",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/copy-contract-fonts.mjs",
    "predev": "node scripts/copy-contract-fonts.mjs",
    "build": "next build --webpack && node scripts/cf-pages-postbuild.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ./functions/tsconfig.json && tsc --noEmit -p ./functions/tsconfig.test.json && tsc -p ./scripts/tsconfig.json && tsc -p ./scripts/tsconfig.test.json",
    "og-image": "node scripts/generate-og-image.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf .next out *.tsbuildinfo"
  },
  "dependencies": {
    "@civfix/contract": "^0.71.1",
    "@civfix/tokens": "workspace:*",
    "@civfix/ui": "workspace:*",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@tanstack/react-query": "^5.102.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "lucide-react-native": "1.17.0",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@civfix/testing": "workspace:*",
    "@eslint-react/eslint-plugin": "5.20.8",
    "@fontsource/baloo-2": "^5",
    "@fontsource/bricolage-grotesque": "^5",
    "@fontsource/jetbrains-mono": "^5",
    "@fontsource/manrope": "^5",
    "@next/eslint-plugin-next": "16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "5.103.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@typescript/native": "npm:typescript@^7",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.5",
    "wrangler": "4.152.0"
  }
}
