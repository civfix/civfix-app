{
  "name": "community-web",
  "version": "1.2.0",
  "private": true,
  "description": "civfix public user web app: static-exported Next.js SPA over the civfix API.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/copy-contract-fonts.mjs",
    "predev": "node scripts/copy-contract-fonts.mjs",
    "build": "next build && node scripts/cf-pages-postbuild.mjs",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ./functions/tsconfig.json",
    "og-image": "node scripts/generate-og-image.mjs",
    "test": "vitest run",
    "clean": "rimraf .next out *.tsbuildinfo",
    "legal-hashes": "node scripts/legal-hashes.mjs"
  },
  "dependencies": {
    "@civfix/shared": "workspace:*",
    "@civfix/ui": "workspace:*",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@radix-ui/react-slot": "^1.1.1",
    "@tanstack/react-query": "^5.62.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "lucide-react-native": "1.17.0",
    "maplibre-gl": "^4.7.1",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@fontsource/baloo-2": "^5",
    "@fontsource/bricolage-grotesque": "^5",
    "@fontsource/jetbrains-mono": "^5",
    "@fontsource/manrope": "^5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.25",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
