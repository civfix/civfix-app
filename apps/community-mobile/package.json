{
  "name": "community-mobile",
  "version": "1.4.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "postinstall": "pnpm --filter @civfix/tokens build",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./tests/setup.mts --test 'src/**/*.test.ts' 'app/**/*.test.ts' 'tests/**/*.test.ts'",
    "test:coverage": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./tests/setup.mts --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-include='app/**' --test-coverage-exclude='**/*.test.ts' --test-coverage-lines=73 --test-coverage-branches=84 --test-coverage-functions=60 --test 'src/**/*.test.ts' 'app/**/*.test.ts' 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc -p scripts/tsconfig.json",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 eslint . --max-warnings=0",
    "doctor:expo": "expo-doctor",
    "export": "expo export",
    "build:testflight": "scripts/store-build.sh testflight",
    "build:appstore": "scripts/store-build.sh appstore",
    "prep:testflight": "scripts/prep-archive.sh testflight",
    "prep:appstore": "scripts/prep-archive.sh appstore"
  },
  "dependencies": {
    "@civfix/contract": "^0.71.1",
    "@civfix/tokens": "workspace:*",
    "@civfix/ui": "workspace:*",
    "@expo-google-fonts/baloo-2": "^0.4.2",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@maplibre/maplibre-react-native": "^11.3.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.102.0",
    "expo": "~56.0.24",
    "expo-apple-authentication": "~56.0.4",
    "expo-blur": "~56.0.4",
    "expo-build-properties": "~56.0.27",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.27",
    "expo-crypto": "~56.0.5",
    "expo-dev-client": "~56.0.28",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image-manipulator": "~56.0.26",
    "expo-image-picker": "~56.0.25",
    "expo-linking": "~56.0.19",
    "expo-localization": "~56.0.6",
    "expo-location": "~56.0.26",
    "expo-navigation-bar": "~56.0.3",
    "expo-notifications": "~56.0.26",
    "expo-router": "~56.2.22",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.16",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.27",
    "expo-web-browser": "~56.0.6",
    "lucide-react-native": "1.17.0",
    "maplibre-gl": "^6.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-compressor": "^1.18.2",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-mmkv": "^3.3.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-video": "^6.19.2",
    "react-native-vision-camera": "^4.7.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@civfix/testing": "workspace:*",
    "@eslint-react/eslint-plugin": "5.20.8",
    "@expo/fingerprint": "~0.19.10",
    "@tanstack/eslint-plugin-query": "5.103.2",
    "@types/react": "~19.2.18",
    "@typescript/native": "npm:typescript@^7",
    "eslint": "^9.16.0",
    "eslint-config-expo": "~56.0.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native": "5.0.0",
    "expo-doctor": "1.21.5",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-compressor"
        ]
      }
    }
  }
}
