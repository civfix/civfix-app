{
  "name": "community-mobile",
  "version": "1.2.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "postinstall": "pnpm --filter @civfix/shared build",
    "test": "node --experimental-strip-types --test tests/*.test.ts src/api/*.test.ts src/components/*.test.ts src/lib/*.test.ts src/query/*.test.ts src/theme/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "doctor": "expo-doctor",
    "export": "expo export",
    "build:testflight": "scripts/store-build.sh testflight",
    "build:appstore": "scripts/store-build.sh appstore",
    "prep:testflight": "scripts/prep-archive.sh testflight",
    "prep:appstore": "scripts/prep-archive.sh appstore"
  },
  "dependencies": {
    "@civfix/shared": "workspace:*",
    "@civfix/ui": "workspace:*",
    "@expo-google-fonts/baloo-2": "^0.4.2",
