# civfix community-mobile: build-time public config (Expo EXPO_PUBLIC_* vars).
#
# Copy to `.env` (gitignored) for LOCAL builds (`expo run:ios` / `expo start`). EAS builds read the
# SAME values from eas.json `build.<profile>.env`, so this file is only needed for local device builds.
#
# A HAND-DRIVEN XCODE ARCHIVE ALSO READS `.env` - and nothing else. It never sees eas.json. Do not
# hand-write `.env` for a store build: run `scripts/prep-archive.sh testflight|appstore`, which
# generates it (and re-prebuilds) so the archive can't end up pointed at the wrong API.
#
# Everything here is PUBLIC (compiled into the app binary / visible in OAuth redirects). They are NOT secrets.
# The Google web client SECRET is never here; it lives only in the backend (GOOGLE_OAUTH_CLIENT_SECRET).

# Backend the app talks to. When unset: dev builds use http://localhost:8080; release builds use
# https://api.civfix.dev for an iOS TestFlight install and https://api.civfix.org otherwise (App Store
# install, Android). See src/lib/apiUrl.ts and src/lib/nativeBetaInstall.ts.
# For local backend dev, point at your machine, e.g. http://192.168.x.x:8080 (NOT localhost on a device).
# EXPO_PUBLIC_API_URL=https://api.civfix.org

# Build-time only (NOT bundled into JS), consumed by app.config.js; see scripts/prep-archive.sh.
#   CIVFIX_UPDATE_CHANNEL  EAS Update channel for a LOCAL archive. EAS Build sets this itself from
#                          eas.json, so it is only needed off the EAS path. Must match the plane the
#                          baked API URL belongs to: testflight <-> .dev, production <-> .org.
#   CIVFIX_APPLE_TEAM_ID   Xcode DEVELOPMENT_TEAM. Every prebuild deletes that build setting unless
#                          this is set, so a team chosen in the Xcode UI does not survive.
# CIVFIX_UPDATE_CHANNEL=testflight
# CIVFIX_APPLE_TEAM_ID=

# Google sign-in (Google Cloud project 521996499476).
#   WEB_CLIENT_ID  must equal the backend's GOOGLE_OAUTH_CLIENT_ID; it is the audience the native ID
#                  token is minted for, so server-side verification passes. It also un-gates the button
#                  (the UI hides "Continue with Google" until this is a real value; see AuthOptions.tsx).
#   IOS_CLIENT_ID  the iOS OAuth client (bundle org.civfix.community); it drives the native iOS sign-in UI.
#   IOS_URL_SCHEME the iOS client id REVERSED. Baked into Info.plist at prebuild, so it must be real at
#                  build time or the native Google sheet can't open.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=521996499476-d86mdmhsuopfp9gmqf7qarc2ousv6sqt.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=521996499476-0oghodcp5h8o3anfob8k71ltj9h6ab1t.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.521996499476-0oghodcp5h8o3anfob8k71ltj9h6ab1t

# Publishable CARTO basemap api key, appended to the CARTO Voyager raster tile URLs (it removes CARTO's
# watermark). Public like the Google ids above - it ships inside the app bundle. app.config.js falls back
# to this same committed value, so leaving it unset still builds a keyed app; blank it out and the map
# renders the keyless, watermarked tiles.
EXPO_PUBLIC_CARTO_API_KEY=cb1_2800_1_9e1f147ec5d25247379fe9cf
